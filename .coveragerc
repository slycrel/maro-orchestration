[run]
source = src
omit =
    src/poe_orchestration.egg-info/*
    */test_*
    */tests/*

[report]
# Session 20 adversarial review finding 3.7: coverage was unmeasured. The
# floor is a ratchet — tighten as measured coverage improves, fail if it
# drops below. Baselines: 78.04% (2026-07-14), 80.18% (2026-08-15 stale-test
# sweep re-measure). Ratcheted 70 -> 75 on the 08-15 measure; 5 points of
# headroom stays conservative while the flat-module refactor is active.
fail_under = 75
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if TYPE_CHECKING:
    except ImportError:
    pass  # pragma: no cover

[html]
directory = output/coverage_html
