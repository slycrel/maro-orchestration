{
  "kind": "lease",
  "lifecycle": "stable",
  "provenance": "supplied",
  "measured_by": "internal/workspace/workspace_test.go (TestSecondProcessRefused, TestStaleLeaseTakenOverWithHigherEpoch, TestEpochSurvivesRelease)",
  "fields": {
    "pid": {"absence": "never", "on_absence": "rejected", "used_for": "identity", "constraint": "defined", "pattern": "^[1-9][0-9]*$", "measured_by": "workspace.alive(pid) — kill -0; EPERM counts as alive"},
    "epoch": {"absence": "never", "on_absence": "rejected", "used_for": "identity", "constraint": "defined", "pattern": "^[1-9][0-9]*$", "measured_by": "epoch file is monotonic across release and takeover (tests)"},
    "host": {"absence": "empty", "on_absence": "tolerated", "used_for": "display-only", "unknown_value": "accepted-unchanged", "constraint": "unconstrained"}
  }
}
