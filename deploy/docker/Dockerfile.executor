# Maro containerized executor image.
#
# Wraps ONLY the agentic executor lane — worker steps that run
# `claude -p ... --dangerously-skip-permissions` with real tools — in a
# filesystem/network-isolated container. Off by default
# (executor.container: off); see docs/CONTAINER_EXECUTOR_DESIGN.md.
#
# The CLI is BAKED, not host-mounted (design §3): reproducible, no host-path
# assumptions, image version auditable. The single source of truth for the
# pin is CLAUDE_CLI_VERSION in src/container_exec.py — the build command
# printed by `maro-bootstrap container-setup` passes it as --build-arg.
#
# The tag is maro-executor:<cli-version>-r<image-revision>. The CLI pin
# answers "which claude"; the revision answers "which image". ANY change to
# this file that does not move CLAUDE_CLI_VERSION must bump IMAGE_REVISION in
# src/container_exec.py — otherwise one tag names two different images, which
# is exactly the auditability the bake was for. A test enforces this pairing
# (tests/test_container_exec.py, Dockerfile digest census).
#
# Build:
#   docker build --build-arg CLAUDE_CLI_VERSION=<v> \
#       -t maro-executor:<v>-r<n> -f deploy/docker/Dockerfile.executor .
# Confirm the current published CLI version:
#   npm view @anthropic-ai/claude-code version

FROM node:22-slim

# Default kept in sync with src/container_exec.py:CLAUDE_CLI_VERSION; the
# build command always passes it explicitly, so this is only a fallback.
ARG CLAUDE_CLI_VERSION=2.1.210

# Toolset worker transcripts actually use: git (clone/commit), python3
# (scripts), curl (fetches). coreutils ships in the debian base.
#
# python3-pytest added 2026-08-06 from transcript evidence, not guesswork.
# Run d9607baa bootstrapped pip from get-pip.py (`--user
# --break-system-packages`) and installed pytest FIFTEEN times — once per
# step, because every step is a fresh container, so nothing installed at
# runtime survives. Every one of those installs was bare `pytest`: no
# plugins, no other package. Baking it removes a tax every "run the tests"
# goal was paying in steps and dollars.
#
# apt, NOT pip, deliberately. The image is a minimal isolation surface by
# design, and shipping pip would let any step install arbitrary packages
# from PyPI at run time — a supply-chain surface far wider than the problem.
# apt pins pytest to debian stable (7.2.1 on bookworm), which satisfies
# every suite seen so far. A goal that genuinely needs a newer pytest or a
# plugin can still bootstrap pip exactly as before; it just is not the
# common case paying for the rare one.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git python3 python3-pytest curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Bake the pinned CLI.
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CLI_VERSION}"

# Fixed HOME so the dedicated auth volume (maro-claude-auth) mounts at a known
# path — /home/maro/.claude — regardless of the arbitrary `--user <uid>:<gid>`
# the executor wrap runs with. World-writable so that arbitrary uid can
# refresh OAuth tokens into the volume (the volume's own perms govern the
# persisted state).
ENV HOME=/home/maro
RUN mkdir -p /home/maro/.claude && chmod -R 0777 /home/maro

# The executor wrap sets the real working dir at runtime (-w <fence-dir>);
# this is only the default when run standalone (e.g. the login/probe steps).
WORKDIR /home/maro

# No ENTRYPOINT: the wrap supplies the full `claude -p ...` command vector,
# and the operator's setup/probe steps supply `claude /login` / `claude -p ok`.
CMD ["claude", "--version"]
